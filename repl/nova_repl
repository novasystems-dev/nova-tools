#!/usr/bin/env python3
"""
NOVA REPL: Interactive Read-Eval-Print Loop for the Nova Systems Programming Language
"""

import sys
import os
import shutil
import tempfile
import subprocess
import signal
try:
    signal.signal(signal.SIGPIPE, signal.SIG_DFL)
except (AttributeError, ValueError):
    pass
try:
    import readline
except ImportError:
    pass

def find_novac():
    if "NOVAC_BIN" in os.environ:
        nb = os.environ["NOVAC_BIN"]
        if os.path.exists(nb):
            return nb
        if os.path.exists(nb + ".exe"):
            return nb + ".exe"
    which_novac = shutil.which("novac")
    if which_novac and os.path.exists(which_novac):
        return which_novac
    rel_novac = os.path.abspath(os.path.join(os.path.dirname(__file__), "../../bin/novac"))
    if os.path.exists(rel_novac):
        return rel_novac
    if os.path.exists(rel_novac + ".exe"):
        return rel_novac + ".exe"
    home_novac = os.path.expanduser("~/Documents/Nova/bin/novac")
    if os.path.exists(home_novac):
        return home_novac
    if os.path.exists(home_novac + ".exe"):
        return home_novac + ".exe"
    return "novac"

NOVAC_BIN = find_novac()

BANNER = r"""
==========================================================
   _   _  _____  __      __     _
  | \ | |/ _ \ \ \ \    / /\   | |
  |  \| | | | \ \ \ \  / /  \  | |
  | |\  | |_| / /  \ \/ / /\ \ |_|
  |_| \_|\___/_/    \__/ /  \_\(_)

  Nova Systems Programming Language v0.1.0-alpha
  Zero GC | Perceus In-Place Reuse | Refinement Safety
  Type expressions, statements, or ':help' for commands.
  Press Ctrl+D or type ':quit' to exit.
==========================================================
"""

HELP_TEXT = """
Nova REPL Commands:
  :help           Display this help manual
  :reset          Clear REPL session environment and history
  :quit           Exit interactive REPL session
  :env            Display currently defined global variables and statements

Syntax:
  let x = 42
  let y = x * 2
  print("Hello from Nova REPL!")
"""

def main():
    print(BANNER)
    history = []
    
    while True:
        try:
            line = input("nova> ").strip()
        except (EOFError, KeyboardInterrupt):
            print("\nExiting Nova REPL. Goodbye!")
            break

        if not line:
            continue

        if line == ":quit" or line == ":q":
            print("Exiting Nova REPL. Goodbye!")
            break
        elif line == ":help" or line == ":h":
            print(HELP_TEXT)
            continue
        elif line == ":reset":
            history.clear()
            print("🔄 Session reset. Environment cleared.")
            continue
        elif line == ":env":
            print("Active Session Statements:")
            for idx, item in enumerate(history, 1):
                print(f"  [{idx}] {item}")
            continue

        # Prepare evaluation snippet
        is_stmt = (
            line.startswith("let ") or
            line.startswith("pub ") or
            line.startswith("type ") or
            line.startswith("trait ") or
            line.startswith("impl ") or
            line.startswith("fn ") or
            "=" in line
        )

        test_history = list(history)
        if is_stmt:
            test_history.append(line)
            eval_target = None
        else:
            eval_target = line

        # Generate temporary Nova source program
        src_lines = ["# Nova REPL Interactive Transient Unit", "pub fn main():"]
        for stmt in test_history:
            src_lines.append(f"    {stmt}")
        
        if eval_target:
            # If target is an expression, wrap in print if it's printable
            if not eval_target.startswith("print"):
                src_lines.append(f"    let _repl_res = {eval_target}")
                src_lines.append(f"    print_int(_repl_res)")
            else:
                src_lines.append(f"    {eval_target}")

        code = "\n".join(src_lines) + "\n"

        with tempfile.NamedTemporaryFile("w", suffix=".nova", delete=False) as f:
            f.write(code)
            tmp_path = f.name

        try:
            # Run transient program via novac run
            proc = subprocess.run(
                [NOVAC_BIN, "run", tmp_path],
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True
            )
            if proc.returncode == 0:
                output = proc.stdout
                clean_lines = [
                    l for l in output.splitlines()
                    if not any(k in l for k in [
                        "NOVAC", "Genesis Stage", "Nova Systems Programming", "Executing binary",
                        "===", "---", "Loaded source", "Checking source", "[1/3]", "[2/3]", "[3/3]",
                        "All formal properties"
                    ]) and l.strip()
                ]
                filtered = "\n".join(clean_lines).strip()
                if filtered:
                    print(f"=> {filtered}")
                
                # Keep statement in session history
                if is_stmt:
                    history.append(line)
            else:
                # Print compiler error message cleanly
                err = proc.stderr.strip() or proc.stdout.strip()
                if "Type/Proof Error" in err or "Parse Error" in err:
                    for l in err.splitlines():
                        if "Error" in l or "Undefined" in l:
                            print(f"❌ {l}")
                else:
                    print(err)
        finally:
            if os.path.exists(tmp_path):
                os.remove(tmp_path)
            out_bin = tmp_path.replace(".nova", ".out")
            if os.path.exists(out_bin):
                os.remove(out_bin)
            out_exe = tmp_path.replace(".nova", ".out.exe")
            if os.path.exists(out_exe):
                os.remove(out_exe)
            c_file = os.path.join(tempfile.gettempdir(), os.path.basename(tmp_path).replace(".nova", ".c"))
            if os.path.exists(c_file):
                os.remove(c_file)

if __name__ == "__main__":
    try:
        main()
    except (BrokenPipeError, KeyboardInterrupt):
        try:
            sys.stdout.close()
        except Exception:
            pass
        sys.exit(0)
